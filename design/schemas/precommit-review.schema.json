{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fw.local/schemas/precommit-review.schema.json",
  "title": ".agents/state/precommit-review.json (precommit-review skill output; pipeline profile precommit RV1, RV2, RV5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocking",
    "nits",
    "at",
    "confirm_scope_hits",
    "u2"
  ],
  "properties": {
    "blocking": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/f"
      }
    },
    "nits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/f"
      },
      "description": "non-blocking style/naming/readability notes; never sent to the author agent as fix requests (F1e)"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "trust_boundary_hits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "RV2 hits; recorded, do not block the commit, force human approval at PR"
    },
    "checks_ok": {
      "type": "boolean",
      "description": "RV1: inner verify green"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id",
        "tool",
        "executed_by",
        "attestation",
        "context"
      ],
      "properties": {
        "tool": {
          "$ref": "review-config.schema.json#/$defs/review_tool"
        },
        "executed_by": {
          "$ref": "review-config.schema.json#/$defs/review_executed_by"
        },
        "attestation": {
          "$ref": "review-config.schema.json#/$defs/review_attestation"
        },
        "context": {
          "$ref": "review-config.schema.json#/$defs/review_context"
        },
        "self_reason": {
          "$ref": "review-config.schema.json#/$defs/review_self_reason"
        },
        "session_id": {
          "type": "string",
          "description": "the platform session id when known: a hook input session_id (local) or the CI action's session_id output; absent when nobody reported one"
        },
        "agent_id": {
          "type": "string",
          "description": "agent_id of the observed subagent (SubagentStart or SubagentStop hook input)"
        },
        "agent_type": {
          "type": "string",
          "description": "agent_type of the observed subagent (hook input), the reviewer id"
        },
        "reviewed_ref": {
          "type": "string",
          "description": "what was reviewed: the staged tree hash (precommit) or the head sha"
        },
        "reviewer_id": {
          "$ref": "review-config.schema.json#/$defs/reviewer_id"
        }
      },
      "description": "the local review record (advisory, attested locally; INDEPCI 2026-10-29)"
    },
    "confirm_scope_hits": {
      "type": "array",
      "description": "RV2.confirm_scope hits (U2 confirm_scope categories)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "category",
          "glob"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "category": {
            "enum": [
              "hooks",
              "permissions",
              "ci",
              "claude_settings",
              "codex_dir",
              "review_config"
            ]
          },
          "glob": {
            "type": "string"
          }
        }
      }
    },
    "u2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "human_confirmation",
        "action"
      ],
      "description": "U2 final confirmation record written by the commit procedure. pr_only_tier2: do not commit to the default branch, do not merge; work branch + PR only (U2.non_interactive, user 2026-10-14)",
      "properties": {
        "run": {
          "enum": [
            "interactive",
            "non_interactive",
            "unknown"
          ]
        },
        "human_confirmation": {
          "enum": [
            "not_required",
            "obtained",
            "not_obtained"
          ]
        },
        "action": {
          "enum": [
            "commit",
            "pr_only_tier2"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "human_confirmation": {
                "const": "not_obtained"
              }
            },
            "required": [
              "human_confirmation"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "pr_only_tier2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "human_confirmation": {
                "enum": [
                  "obtained",
                  "not_required"
                ]
              }
            },
            "required": [
              "human_confirmation"
            ]
          },
          "then": {
            "properties": {
              "action": {
                "const": "commit"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "run": {
                "enum": [
                  "non_interactive",
                  "unknown"
                ]
              }
            },
            "required": [
              "run"
            ]
          },
          "then": {
            "properties": {
              "human_confirmation": {
                "enum": [
                  "not_required",
                  "not_obtained"
                ]
              }
            }
          }
        }
      ]
    },
    "criteria": {
      "$ref": "review-config.schema.json#/$defs/criteria_map"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{7,64}$",
      "description": "HEAD when the review ran (the staged diff is reviewed on top of it)"
    },
    "tree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$",
      "description": "the staged tree this review covered (`git write-tree` of the index when the review ran). The PR skill copies this record into the PR body only when it equals HEAD^{tree}; any other value, or none, is a stale record: it is dropped with a NOTE PRECOMMIT_STALE and the PR body carries no review entry from it (E2E-44)"
    }
  },
  "$defs": {
    "f": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "trigger",
        "summary"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "pre_existing": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "description": "no hit -> not_required",
      "if": {
        "properties": {
          "confirm_scope_hits": {
            "maxItems": 0
          }
        },
        "required": [
          "confirm_scope_hits"
        ]
      },
      "then": {
        "properties": {
          "u2": {
            "properties": {
              "human_confirmation": {
                "const": "not_required"
              }
            }
          }
        }
      }
    },
    {
      "description": "hit -> obtained or not_obtained",
      "if": {
        "properties": {
          "confirm_scope_hits": {
            "minItems": 1
          }
        },
        "required": [
          "confirm_scope_hits"
        ]
      },
      "then": {
        "properties": {
          "u2": {
            "properties": {
              "human_confirmation": {
                "enum": [
                  "obtained",
                  "not_obtained"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
