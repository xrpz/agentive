{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fw.local/schemas/review-rules.schema.json",
  "title": "```yaml agentive-review-rules``` block in the review criteria file (code_review.md, the single criteria file; U4=C)",
  "description": "Rules data for RV2 (trust boundary and confirm_scope), RV3 (deterministic classification) and RV4 (tier). Read by scripts from the base commit (git show $BASE_SHA:code_review.md), never from the PR branch, and never by LLM reviewers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agentive-review-rules"
  ],
  "properties": {
    "agentive-review-rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trust_boundary",
        "tiers"
      ],
      "properties": {
        "trust_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "never_ai_approve",
            "confirm_scope_globs"
          ],
          "properties": {
            "confirm_scope_globs": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hooks",
                "permissions",
                "ci",
                "claude_settings",
                "codex_dir",
                "review_config"
              ],
              "description": "RV2.confirm_scope (U2.non_interactive, user decision 2026-10-14): one glob list per U2 confirm_scope category (review_config added 2026-10-15 with the U6 customization). A changed path that matches, made without a human confirmation, is delivered as a PR only and RV4 forces tier 2. The project may add globs (for example generated hook scripts); every category keeps at least one glob, so the check cannot be emptied.",
              "properties": {
                "hooks": {
                  "$ref": "#/$defs/globs"
                },
                "permissions": {
                  "$ref": "#/$defs/globs"
                },
                "ci": {
                  "$ref": "#/$defs/globs"
                },
                "claude_settings": {
                  "$ref": "#/$defs/globs"
                },
                "codex_dir": {
                  "$ref": "#/$defs/globs"
                },
                "review_config": {
                  "$ref": "#/$defs/globs"
                }
              }
            },
            "never_ai_approve": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "glob",
                  "reason"
                ],
                "properties": {
                  "glob": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "enum": [
                      "auth",
                      "security",
                      "permissions",
                      "secrets",
                      "db_migration",
                      "ci_config",
                      "agent_hooks_settings",
                      "check_config",
                      "billing",
                      "other"
                    ]
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "protected_check_config": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "extra paths the project adds to the protected check-config list (reason check_config). The framework list (.agents/** except .agents/state/**, .claude/**, .codex/**, code_review.md, AGENTS.md/CLAUDE.md managed regions, reviewer eval cases evals/reviewer/**, lint/typecheck/format config files from the agentive manifest evidence.files) is built in and cannot be removed or disabled"
            }
          }
        },
        "classify": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path_rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "glob",
                  "class"
                ],
                "properties": {
                  "glob": {
                    "type": "string"
                  },
                  "class": {
                    "$ref": "#/$defs/class"
                  }
                }
              }
            },
            "whitespace_only_is_format": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tier0_classes",
            "tier0_max_changed_lines",
            "large_change_lines",
            "confirm_scope_without_human_tier"
          ],
          "properties": {
            "confirm_scope_without_human_tier": {
              "const": 2,
              "description": "RV4.u2_non_interactive: a confirm_scope hit without human confirmation is tier 2. Fixed by the user decision U2.non_interactive; not tunable."
            },
            "tier0_classes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/tier0_class"
              },
              "uniqueItems": true,
              "default": [
                "docs",
                "format"
              ],
              "description": "default docs and format (conservative); a project may add lockfile or generated, never another class"
            },
            "tier0_max_changed_lines": {
              "type": "integer",
              "minimum": 0,
              "default": 200
            },
            "large_change_lines": {
              "type": "integer",
              "minimum": 1,
              "default": 1000
            },
            "tier2_classes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/class"
              },
              "default": [
                "security"
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "globs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "class": {
      "enum": [
        "docs",
        "format",
        "refactor",
        "feature",
        "fix",
        "security",
        "deps",
        "lockfile",
        "config",
        "test",
        "generated",
        "other"
      ]
    },
    "tier0_class": {
      "enum": [
        "docs",
        "format",
        "lockfile",
        "generated"
      ],
      "description": "classes that may be tier 0: only mechanically verifiable changes decided by rules (2026-10-27)"
    }
  }
}
