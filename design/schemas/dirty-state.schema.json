{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fw.local/schemas/dirty-state.schema.json",
  "title": ".agents/state/dirty.json (FileChanged hook marks slots to re-prove)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slots"
  ],
  "properties": {
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "file",
          "at"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^(verbs|paths)\\.[a-z_]+$"
          },
          "file": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
